# Maintainer: funkypitt <pierregallaz@gmail.com>
# Arch / Manjaro: cd packaging && makepkg -si
pkgname=readers-video-editor
pkgver=1.6.0
pkgrel=1
pkgdesc="Cut a video or a recording by highlighting its text; comfortable reading of the transcript"
arch=('any')
url="https://github.com/funkypitt/readers-video-editor"
license=('MIT')
depends=('python' 'python-pip' 'python-pyqt5' 'python-numpy' 'python-soundfile' 'ffmpeg' 'gst-plugins-good' 'gst-libav')
optdepends=('python-faster-whisper: transcription on this computer')
source=("$pkgname-$pkgver.tar.gz::https://github.com/funkypitt/readers-video-editor/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
  cd "$srcdir/readers-video-editor-$pkgver"
  install -Dm755 readers_video_editor.py "$pkgdir/usr/lib/readers-video-editor/readers_video_editor.py"
  for f in packaging/fonts/*; do install -Dm644 "$f" "$pkgdir/usr/lib/readers-video-editor/fonts/$(basename "$f")"; done
  install -Dm755 /dev/stdin "$pkgdir/usr/bin/readers-video-editor" <<'SH'
#!/bin/sh
exec python3 /usr/lib/readers-video-editor/readers_video_editor.py "$@"
SH
  install -Dm644 packaging/readers-video-editor.desktop "$pkgdir/usr/share/applications/readers-video-editor.desktop"
  install -Dm644 packaging/readers-video-editor.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/readers-video-editor.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
